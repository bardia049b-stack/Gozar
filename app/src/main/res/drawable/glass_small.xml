<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/glass" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
        </shape>
    </item>
    <item android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#2BFFFFFF" android:endColor="#00FFFFFF" android:type="linear" />
        </shape>
    </item>
</layer-list>
