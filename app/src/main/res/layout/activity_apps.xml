<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/btnBackApps" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/circle_glass" android:padding="9dp" android:src="@drawable/ic_close" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/apps_title" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text2" android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            style="@style/Field"
            android:layout_marginTop="12dp"
            android:hint="@string/search" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="14dp" android:layout_marginBottom="20dp" android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/llApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_small" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
