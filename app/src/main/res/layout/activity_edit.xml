<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="30dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/circle_glass"
                    android:padding="9dp"
                    android:src="@drawable/ic_close" />

                <TextView
                    android:id="@+id/tvEditTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/ed_new"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSaveTop"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_primary"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/save"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnQr"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/menu_qr" />

                <TextView
                    android:id="@+id/btnShare"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/menu_share" />

                <TextView
                    android:id="@+id/btnExport"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/menu_export" />

                <TextView
                    android:id="@+id/btnDelete"
                    style="@style/SmallBtn"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/menu_delete"
                    android:textColor="@color/red" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/glass_small"
                android:orientation="horizontal"
                android:padding="5dp">

                <TextView
                    android:id="@+id/segForm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:gravity="center"
                    android:text="@string/form"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/segRaw"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/raw"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/FieldLabel" android:text="@string/name" />
                <EditText android:id="@+id/etName" style="@style/Field" android:hint="My VPN" />

                <TextView style="@style/SectionLabel" android:text="@string/interface_sec" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_small"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="@string/private_key" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <EditText android:id="@+id/etPriv" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:inputType="textNoSuggestions" />
                        <TextView android:id="@+id/btnGenPriv" style="@style/SmallBtn" android:layout_marginStart="8dp" android:text="@string/generate" />
                    </LinearLayout>

                    <TextView style="@style/FieldLabel" android:text="@string/your_public" />
                    <TextView android:id="@+id/tvPub" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/field" android:padding="14dp" android:textColor="@color/text2" android:textSize="13sp" />

                    <TextView style="@style/FieldLabel" android:text="@string/address" />
                    <EditText android:id="@+id/etAddr" style="@style/Field" android:hint="10.0.0.2/32" android:inputType="textNoSuggestions" />

                    <TextView style="@style/FieldLabel" android:text="@string/dns" />
                    <EditText android:id="@+id/etDns" style="@style/Field" android:hint="1.1.1.1" android:inputType="textNoSuggestions" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="@string/mtu" />
                            <EditText android:id="@+id/etMtu" style="@style/Field" android:hint="1280" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="@string/listen_port" />
                            <EditText android:id="@+id/etPort" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="@string/awg_sec" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_small"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Jc" />
                            <EditText android:id="@+id/etJc" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Jmin" />
                            <EditText android:id="@+id/etJmin" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Jmax" />
                            <EditText android:id="@+id/etJmax" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="S1" />
                            <EditText android:id="@+id/etS1" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="S2" />
                            <EditText android:id="@+id/etS2" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="S3" />
                            <EditText android:id="@+id/etS3" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="S4" />
                            <EditText android:id="@+id/etS4" style="@style/Field" android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="H1" />
                            <EditText android:id="@+id/etH1" style="@style/Field" android:inputType="textNoSuggestions" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="H2" />
                            <EditText android:id="@+id/etH2" style="@style/Field" android:inputType="textNoSuggestions" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="H3" />
                            <EditText android:id="@+id/etH3" style="@style/Field" android:inputType="textNoSuggestions" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/FieldLabel" android:text="H4" />
                            <EditText android:id="@+id/etH4" style="@style/Field" android:inputType="textNoSuggestions" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnRandomAwg"
                        style="@style/SmallBtn"
                        android:layout_marginTop="16dp"
                        android:text="@string/random_awg" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="@string/peer_sec" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_small"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="@string/peer_public" />
                    <EditText android:id="@+id/etPeerPub" style="@style/Field" android:inputType="textNoSuggestions" />

                    <TextView style="@style/FieldLabel" android:text="@string/preshared" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <EditText android:id="@+id/etPsk" style="@style/Field" android:layout_width="0dp" android:layout_weight="1" android:inputType="textNoSuggestions" />
                        <TextView android:id="@+id/btnGenPsk" style="@style/SmallBtn" android:layout_marginStart="8dp" android:text="@string/generate" />
                    </LinearLayout>

                    <TextView style="@style/FieldLabel" android:text="@string/endpoint" />
                    <EditText android:id="@+id/etEndpoint" style="@style/Field" android:hint="server.example.com:51820" android:inputType="textNoSuggestions" />

                    <TextView style="@style/FieldLabel" android:text="@string/allowed_ips" />
                    <EditText android:id="@+id/etAllowed" style="@style/Field" android:hint="0.0.0.0/0, ::/0" android:inputType="textNoSuggestions" />

                    <TextView style="@style/FieldLabel" android:text="@string/keepalive" />
                    <EditText android:id="@+id/etKeepalive" style="@style/Field" android:hint="25" android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/etRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_small"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:minLines="16"
                android:padding="16dp"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
