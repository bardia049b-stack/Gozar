<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Gozar.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="@dimen/sp_s"
        android:paddingEnd="@dimen/sp_s"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/ed_new"
        app:titleTextAppearance="@style/Gozar.Toolbar.Title" />

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQr"
            style="@style/Widget.Gozar.Button.Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/menu_qr"
            app:icon="@drawable/ic_qr" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Gozar.Button.Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/menu_share"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.Gozar.Button.Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/menu_export"
            app:icon="@drawable/ic_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.Gozar.Button.Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/menu_delete"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorError" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/sp_s"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/sp_l">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/pill"
                android:backgroundTint="?attr/colorSurfaceContainerHigh"
                android:orientation="horizontal"
                android:padding="@dimen/sp_xs">

                <TextView
                    android:id="@+id/segForm"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:text="@string/form"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelLarge" />

                <TextView
                    android:id="@+id/segRaw"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:text="@string/raw"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelLarge" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Gozar.Field"
                android:layout_marginTop="@dimen/sp_l"
                android:hint="@string/name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/formBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Gozar.Section"
                    android:text="@string/interface_sec" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/sp_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:hint="@string/private_key">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPriv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textNoSuggestions"
                                android:maxLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvPub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textDirection="ltr" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenPriv"
                            style="@style/Widget.Gozar.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/generate"
                            app:icon="@drawable/ic_auto_awesome" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:layout_marginTop="@dimen/sp_s"
                            android:hint="@string/address">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAddr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:layout_marginTop="@dimen/sp_m"
                            android:hint="@string/dns">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDns"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_m"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/mtu">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMtu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="@string/listen_port">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPort"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Gozar.Section"
                    android:text="@string/awg_sec" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/sp_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="Jc">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etJc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="Jmin">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etJmin"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="Jmax">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etJmax"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_m"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="S1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etS1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="S2">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etS2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="S3">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etS3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="S4">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etS4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_m"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="H1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etH1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="H2">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etH2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="H3">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etH3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="H4">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etH4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_m"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="I1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etI1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="I2">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etI2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="I3">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etI3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_m"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="I4">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etI4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Gozar.Field"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1"
                                android:hint="I5">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etI5"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/sp_m"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRandomAwg"
                            style="@style/Widget.Gozar.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_xs"
                            android:text="@string/random_awg"
                            app:icon="@drawable/ic_auto_awesome" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Gozar.Section"
                    android:text="@string/peer_sec" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/sp_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:hint="@string/peer_public">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPeerPub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:layout_marginTop="@dimen/sp_m"
                            android:hint="@string/preshared">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPsk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenPsk"
                            style="@style/Widget.Gozar.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/generate"
                            app:icon="@drawable/ic_key" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:layout_marginTop="@dimen/sp_s"
                            android:hint="@string/endpoint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEndpoint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:layout_marginTop="@dimen/sp_m"
                            android:hint="@string/allowed_ips">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAllowed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Gozar.Field"
                            android:layout_marginTop="@dimen/sp_m"
                            android:hint="@string/keepalive">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etKeepalive"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/rawBox"
                style="@style/Gozar.Field"
                android:layout_marginTop="@dimen/sp_l"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="12"
                    android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:orientation="horizontal"
        android:padding="@dimen/sp_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTop"
            style="@style/Widget.Gozar.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            app:icon="@drawable/ic_save" />
    </LinearLayout>
</LinearLayout>
