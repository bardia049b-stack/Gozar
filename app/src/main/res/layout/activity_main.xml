<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/logo"
                app:tint="?attr/colorOnSurface" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSettingsTop"
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_m"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="44dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_l"
                android:paddingTop="@dimen/sp_l"
                android:paddingEnd="@dimen/sp_l"
                android:paddingBottom="@dimen/sp_l">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="236dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.gozarwg.WorldRouteView
                        android:id="@+id/worldRoute"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <com.gozarwg.ConnectControl
                        android:id="@+id/connectButton"
                        android:layout_width="208dp"
                        android:layout_height="208dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/connect" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:text="@string/status_off"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <com.gozarwg.ConnectionPulse
                    android:id="@+id/connectionPulse"
                    android:layout_width="156dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tap_connect"
                    android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/connectionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_m"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivFlag"
                            android:layout_width="22dp"
                            android:layout_height="15dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/location"
                            android:scaleType="fitCenter"
                            android:src="@drawable/flag_ir"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvFlag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvIp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_s"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textDirection="ltr" />

                        <com.gozarwg.RollingValueView
                            android:id="@+id/tvPing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_s"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textDirection="ltr" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProvider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/profileCard"
            style="@style/Gozar.Row"
            android:layout_marginTop="@dimen/sp_l">

            <ImageView
                android:id="@+id/profileTile"
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_squircle"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/select_profile"
                android:src="@drawable/ic_dns"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">

                <TextView
                    android:id="@+id/tvCurrentName"
                    style="@style/Gozar.Row.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/empty_title" />

                <TextView
                    android:id="@+id/tvCurrentMeta"
                    style="@style/Gozar.Row.Subtitle"
                    android:maxLines="1"
                    android:text="@string/empty_desc" />
            </LinearLayout>

            <ImageView
                style="@style/Gozar.Row.Chevron"
                android:contentDescription="@string/select_profile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sp_m"
                        android:paddingEnd="@dimen/sp_m">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:contentDescription="@string/download">

                            <View
                                android:id="@+id/downBadge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/frame_clover"
                                android:backgroundTint="@color/tile_container" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_down"
                                app:tint="@color/tile_on_container" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.gozarwg.RollingValueView
                                android:id="@+id/tvDown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="0 B/s"
                                android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                android:textDirection="ltr" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/download"
                                android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="@dimen/sp_s"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sp_m"
                        android:paddingEnd="@dimen/sp_m">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:contentDescription="@string/upload">

                            <View
                                android:id="@+id/upBadge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/frame_burst"
                                android:backgroundTint="@color/tile_container" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="11dp"
                                android:src="@drawable/ic_up"
                                app:tint="@color/tile_on_container" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.gozarwg.RollingValueView
                                android:id="@+id/tvUp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="0 B/s"
                                android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                android:textDirection="ltr" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/upload"
                                android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_s"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sp_m"
                        android:paddingEnd="@dimen/sp_m">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/frame_puff"
                            android:backgroundTint="@color/tile_container"
                            android:contentDescription="@string/total"
                            android:padding="11dp"
                            android:src="@drawable/ic_data"
                            app:tint="@color/tile_on_container" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.gozarwg.RollingValueView
                                android:id="@+id/tvTotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="0 B"
                                android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                android:textDirection="ltr" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/total"
                                android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="@dimen/sp_s"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/sp_m"
                        android:paddingEnd="@dimen/sp_m">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/frame_flower"
                            android:backgroundTint="@color/tile_container"
                            android:contentDescription="@string/handshake"
                            android:padding="11dp"
                            android:src="@drawable/ic_sync"
                            app:tint="@color/tile_on_container" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sp_s"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.gozarwg.RollingValueView
                                android:id="@+id/tvHandshake"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/now"
                                android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hs_short"
                                android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
