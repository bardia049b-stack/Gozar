<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/logo"
                app:tint="?attr/colorOnSurface" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSettingsTop"
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.gozarwg.ConnectControl
            android:id="@+id/connectButton"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/connect" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:gravity="center"
            android:text="@string/status_off"
            android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/connectionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_xl"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFlag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Gozar.HeadlineMedium" />

                <TextView
                    android:id="@+id/tvIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sp_m"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Gozar.HeadlineMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_s"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Gozar.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_xl"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/frame_clover"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/download"
                    android:padding="13dp"
                    android:src="@drawable/ic_down"
                    app:tint="@color/tile_on_container" />

                <TextView
                    android:id="@+id/tvDown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0 B/s"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/download"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/frame_burst"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/upload"
                    android:padding="13dp"
                    android:src="@drawable/ic_up"
                    app:tint="@color/tile_on_container" />

                <TextView
                    android:id="@+id/tvUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0 B/s"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/upload"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/frame_puff"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/total"
                    android:padding="13dp"
                    android:src="@drawable/ic_data"
                    app:tint="@color/tile_on_container" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0 B"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/total"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/frame_flower"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/handshake"
                    android:padding="13dp"
                    android:src="@drawable/ic_sync"
                    app:tint="@color/tile_on_container" />

                <TextView
                    android:id="@+id/tvHandshake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/now"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/hs_short"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileCard"
            style="@style/Gozar.Row"
            android:layout_marginTop="@dimen/sp_xl">

            <ImageView
                android:id="@+id/profileTile"
                style="@style/Gozar.Tile"
                android:background="@drawable/tile"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:contentDescription="@string/select_profile"
                android:src="@drawable/ic_dns"
                app:tint="?attr/colorOnSecondaryContainer" />

            <LinearLayout style="@style/Gozar.Row.Text">

                <TextView
                    android:id="@+id/tvCurrentName"
                    style="@style/Gozar.Row.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/empty_title" />

                <TextView
                    android:id="@+id/tvCurrentMeta"
                    style="@style/Gozar.Row.Subtitle"
                    android:maxLines="1"
                    android:text="@string/empty_desc" />
            </LinearLayout>

            <ImageView
                style="@style/Gozar.Row.Chevron"
                android:contentDescription="@string/select_profile" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
