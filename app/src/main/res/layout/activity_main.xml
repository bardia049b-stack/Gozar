<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Gozar.HeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/btnSettingsTop"
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_xl"
                android:paddingTop="@dimen/sp_xxl"
                android:paddingEnd="@dimen/sp_xl"
                android:paddingBottom="@dimen/sp_xl">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sp_m"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/sp_m"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot"
                        android:backgroundTint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sp_s"
                        android:text="@string/status_off"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.gozarwg.ConnectView
                    android:id="@+id/connectButton"
                    android:layout_width="@dimen/connect_button"
                    android:layout_height="@dimen/connect_button"
                    android:layout_marginTop="@dimen/sp_xl">

                    <ImageView
                        android:id="@+id/connectIcon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/connect"
                        android:src="@drawable/ic_power"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </com.gozarwg.ConnectView>

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_xl"
                    android:text="00:00:00"
                    android:textAppearance="@style/TextAppearance.Gozar.DisplaySmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_xs"
                    android:text="@string/tap_connect"
                    android:textAppearance="@style/TextAppearance.Gozar.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/ipRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sp_s"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelLarge"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_m"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/sp_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Gozar.Row.Static"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Gozar.Tile"
                            android:backgroundTint="@color/kind_down_container"
                            android:contentDescription="@string/download"
                            android:src="@drawable/ic_down"
                            app:tint="@color/kind_down_on_container" />

                        <LinearLayout style="@style/Gozar.Row.Text">

                            <TextView
                                android:id="@+id/tvDown"
                                style="@style/Gozar.Stat.Value"
                                android:text="0 B/s" />

                            <TextView
                                style="@style/Gozar.Stat.Label"
                                android:text="@string/download" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Gozar.Row.Static"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Gozar.Tile"
                            android:backgroundTint="@color/kind_up_container"
                            android:contentDescription="@string/upload"
                            android:src="@drawable/ic_up"
                            app:tint="@color/kind_up_on_container" />

                        <LinearLayout style="@style/Gozar.Row.Text">

                            <TextView
                                android:id="@+id/tvUp"
                                style="@style/Gozar.Stat.Value"
                                android:text="0 B/s" />

                            <TextView
                                style="@style/Gozar.Stat.Label"
                                android:text="@string/upload" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Gozar.Row.Static"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Gozar.Tile"
                            android:backgroundTint="@color/kind_total_container"
                            android:contentDescription="@string/total"
                            android:src="@drawable/ic_data"
                            app:tint="@color/kind_total_on_container" />

                        <LinearLayout style="@style/Gozar.Row.Text">

                            <TextView
                                android:id="@+id/tvTotal"
                                style="@style/Gozar.Stat.Value"
                                android:text="0 B" />

                            <TextView
                                style="@style/Gozar.Stat.Label"
                                android:text="@string/total" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Gozar.Row.Static"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Gozar.Tile"
                            android:backgroundTint="@color/kind_handshake_container"
                            android:contentDescription="@string/handshake"
                            android:src="@drawable/ic_sync"
                            app:tint="@color/kind_handshake_on_container" />

                        <LinearLayout style="@style/Gozar.Row.Text">

                            <TextView
                                android:id="@+id/tvHandshake"
                                style="@style/Gozar.Stat.Value"
                                android:text="@string/now" />

                            <TextView
                                style="@style/Gozar.Stat.Label"
                                android:text="@string/handshake" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/profile_section" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/profileCard"
                    style="@style/Gozar.Row">

                    <ImageView
                        android:id="@+id/profileTile"
                        style="@style/Gozar.Tile"
                        android:contentDescription="@string/profiles"
                        android:src="@drawable/ic_dns"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            android:id="@+id/tvCurrentName"
                            style="@style/Gozar.Row.Title"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/no_profiles" />

                        <TextView
                            android:id="@+id/tvCurrentMeta"
                            style="@style/Gozar.Row.Subtitle"
                            android:maxLines="1" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Gozar.Row.Chevron"
                        android:contentDescription="@string/select_profile" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout
                    android:id="@+id/rowPerApp"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_apps_container"
                        android:contentDescription="@string/split"
                        android:src="@drawable/ic_apps"
                        app:tint="@color/kind_apps_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/split" />

                        <TextView
                            android:id="@+id/tvPerAppValue"
                            style="@style/Gozar.Row.Subtitle"
                            android:maxLines="1" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Gozar.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddProfile"
            style="@style/Widget.Gozar.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:text="@string/add_profile"
            app:icon="@drawable/ic_plus" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
