<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/logo"
                app:tint="?attr/colorOnSurface" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnMap"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_map_button"
                android:contentDescription="@string/open_live_map"
                android:padding="12dp"
                android:src="@drawable/ic_map"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/btnSettingsTop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- The primary action comes first. Connection details appear only after a session starts. -->
        <LinearLayout
            android:id="@+id/connectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/sp_s"
            android:paddingBottom="@dimen/sp_s">

            <com.gozarwg.ConnectControl
                android:id="@+id/connectButton"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="@string/connect" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_s"
                android:gravity="center"
                android:text="@string/status_off"
                android:textAppearance="@style/TextAppearance.Gozar.TitleLarge"
                android:textColor="@color/m3_on_surface"
                android:visibility="gone" />

            <com.gozarwg.ConnectionPulse
                android:id="@+id/connectionPulse"
                android:layout_width="156dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/tap_connect"
                android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                android:textColor="@color/m3_on_surface_variant"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/connectionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_m"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivFlag"
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/location"
                        android:scaleType="fitCenter"
                        android:src="@drawable/flag_ir"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvFlag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                        android:textColor="@color/m3_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sp_s"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Gozar.TitleSmall"
                        android:textColor="@color/m3_on_surface"
                        android:textDirection="ltr" />

                    <com.gozarwg.RollingValueView
                        android:id="@+id/tvPing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sp_s"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textDirection="ltr" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProvider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                    android:textColor="@color/m3_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- The profile stays visible before connection, directly after the connect action. -->
        <LinearLayout
            android:id="@+id/profileCard"
            style="@style/Gozar.Row"
            android:layout_marginTop="@dimen/sp_m">

            <ImageView
                android:id="@+id/profileTile"
                android:layout_width="@dimen/tile_size"
                android:layout_height="@dimen/tile_size"
                android:background="@drawable/frame_burst"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/select_profile"
                android:padding="12dp"
                android:src="@drawable/ic_dns"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">

                <TextView
                    android:id="@+id/tvCurrentName"
                    style="@style/Gozar.Row.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/empty_title" />

                <TextView
                    android:id="@+id/tvCurrentMeta"
                    style="@style/Gozar.Row.Subtitle"
                    android:maxLines="1"
                    android:text="@string/empty_desc" />
            </LinearLayout>

            <ImageView
                style="@style/Gozar.Row.Chevron"
                android:contentDescription="@string/select_profile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/frame_burst"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/download"
                    android:padding="16dp"
                    android:src="@drawable/ic_down"
                    app:tint="@color/tile_on_container" />

                <com.gozarwg.RollingValueView
                    android:id="@+id/tvDown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0 B/s"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                    android:textColor="@color/metric_number"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvDownLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/download"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="@color/metric_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/frame_burst"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/upload"
                    android:padding="16dp"
                    android:src="@drawable/ic_up"
                    app:tint="@color/tile_on_container" />

                <com.gozarwg.RollingValueView
                    android:id="@+id/tvUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0 B/s"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                    android:textColor="@color/metric_number"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvUpLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/upload"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="@color/metric_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/frame_burst"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/total"
                    android:padding="16dp"
                    android:src="@drawable/ic_data"
                    app:tint="@color/tile_on_container" />

                <com.gozarwg.RollingValueView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0 B"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                    android:textColor="@color/metric_number"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvTotalLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/total"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="@color/metric_label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/frame_burst"
                    android:backgroundTint="@color/tile_container"
                    android:contentDescription="@string/handshake"
                    android:padding="16dp"
                    android:src="@drawable/ic_sync"
                    app:tint="@color/tile_on_container" />

                <com.gozarwg.RollingValueView
                    android:id="@+id/tvHandshake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/now"
                    android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                    android:textColor="@color/metric_number"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/tvHandshakeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/hs_short"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="@color/metric_label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
