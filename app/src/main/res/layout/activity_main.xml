<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/logo"
                app:tint="?attr/colorOnSurface" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnSettingsTop"
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/sp_m"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/heroMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.72"
                android:contentDescription="@string/status_off"
                android:padding="28dp"
                android:scaleType="centerInside"
                android:src="@drawable/iran_map"
                app:tint="@color/m3_primary" />
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/sp_xl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/Widget.Gozar.ConnectButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/connect"
                android:text="@string/connect"
                app:icon="@drawable/ic_power"
                app:iconGravity="textStart"
                app:iconTint="@color/m3_on_primary" />

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/connectionLoading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="22dp"
                android:clickable="false"
                android:contentDescription="@string/status_connecting"
                android:visibility="invisible"
                app:indicatorColor="@color/m3_on_primary"
                app:indicatorSize="32dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/profileCard"
            style="@style/Gozar.Row"
            android:layout_marginTop="@dimen/sp_m">

            <ImageView
                android:id="@+id/profileTile"
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_squircle"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:contentDescription="@string/select_profile"
                android:src="@drawable/ic_dns"
                app:tint="?attr/colorOnSecondaryContainer" />

            <LinearLayout style="@style/Gozar.Row.Text">

                <TextView
                    android:id="@+id/tvCurrentName"
                    style="@style/Gozar.Row.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/empty_title" />

                <TextView
                    android:id="@+id/tvCurrentMeta"
                    style="@style/Gozar.Row.Subtitle"
                    android:maxLines="1"
                    android:text="@string/empty_desc" />
            </LinearLayout>

            <ImageView
                style="@style/Gozar.Row.Chevron"
                android:contentDescription="@string/select_profile" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
