<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routeMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface">

    <org.osmdroid.views.MapView
        android:id="@+id/fullWorldRoute"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/live_map_content" />

    <ImageView
        android:id="@+id/btnMapBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_map_button"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface" />

    <!-- Required visible OpenStreetMap attribution. -->
    <TextView
        android:id="@+id/tvMapAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/map_attribution"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="@string/osm_attribution"
        android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
        android:textColor="@color/m3_on_surface" />
</FrameLayout>
