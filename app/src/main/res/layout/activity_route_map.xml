<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routeMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface">

    <com.gozarwg.WorldRouteView
        android:id="@+id/fullWorldRoute"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/live_map_content" />

    <ImageView
        android:id="@+id/btnMapBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_map_button"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface" />
</FrameLayout>
