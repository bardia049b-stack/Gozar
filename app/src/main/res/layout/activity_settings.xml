<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/settings"
            android:textAppearance="@style/TextAppearance.Gozar.HeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/st_connection" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowKill"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_kill_container"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/kind_kill_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/kill_switch" />

                        <TextView
                            style="@style/Gozar.Row.Subtitle"
                            android:text="@string/kill_switch_short" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swKill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout
                    android:id="@+id/rowAuto"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_auto_container"
                        android:src="@drawable/ic_rocket"
                        app:tint="@color/kind_auto_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/auto_connect" />

                        <TextView
                            style="@style/Gozar.Row.Subtitle"
                            android:text="@string/auto_connect_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout
                    android:id="@+id/rowLan"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_lan_container"
                        android:src="@drawable/ic_lan"
                        app:tint="@color/kind_lan_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/lan" />

                        <TextView
                            style="@style/Gozar.Row.Subtitle"
                            android:text="@string/lan_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swLan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/st_proxy" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowProxy"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_proxy_container"
                        android:src="@drawable/ic_hub"
                        app:tint="@color/kind_proxy_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/proxy_mode" />

                        <TextView
                            style="@style/Gozar.Row.Subtitle"
                            android:text="@string/proxy_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swProxy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout
                    android:id="@+id/rowPort"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_info_container"
                        android:src="@drawable/ic_router"
                        app:tint="@color/kind_info_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/proxy_port" />

                        <TextView
                            android:id="@+id/tvProxyPort"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/Gozar.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/split" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowSplitMode"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_split_container"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/kind_split_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/split_mode" />

                        <TextView
                            android:id="@+id/tvSplitMode"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/Gozar.Row.Chevron" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout
                    android:id="@+id/rowSplitApps"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_apps_container"
                        android:src="@drawable/ic_apps"
                        app:tint="@color/kind_apps_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/split_apps" />

                        <TextView
                            android:id="@+id/tvSplitApps"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/Gozar.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/theme" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowLang"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_lang_container"
                        android:src="@drawable/ic_translate"
                        app:tint="@color/kind_lang_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/language" />

                        <TextView
                            android:id="@+id/tvLang"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/Gozar.Row.Chevron" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout
                    android:id="@+id/rowTheme"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_theme_container"
                        android:src="@drawable/ic_contrast"
                        app:tint="@color/kind_theme_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/theme" />

                        <TextView
                            android:id="@+id/tvTheme"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/Gozar.Row.Chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/about" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowVpnSettings"
                    style="@style/Gozar.Row">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_secure_container"
                        android:src="@drawable/ic_gpp"
                        app:tint="@color/kind_secure_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            style="@style/Gozar.Row.Title"
                            android:text="@string/vpn_settings" />

                        <TextView
                            style="@style/Gozar.Row.Subtitle"
                            android:text="@string/vpn_settings_desc" />
                    </LinearLayout>

                    <ImageView style="@style/Gozar.Row.Chevron" />
                </LinearLayout>

                <View style="@style/Gozar.Divider" />

                <LinearLayout style="@style/Gozar.Row.Static">

                    <ImageView
                        style="@style/Gozar.Tile"
                        android:backgroundTint="@color/kind_info_container"
                        android:src="@drawable/ic_info"
                        app:tint="@color/kind_info_on_container" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            android:id="@+id/tvAbout"
                            style="@style/Gozar.Row.Title" />

                        <TextView
                            android:id="@+id/tvCore"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvKillDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/kill_switch_desc"
            android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textDirection="locale" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
