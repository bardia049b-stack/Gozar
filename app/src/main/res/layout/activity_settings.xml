<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_s"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textAppearance="@style/TextAppearance.Gozar.HeadlineSmall"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAccountInitial"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_avatar_red"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout style="@style/Gozar.Row.Text">

                        <TextView
                            android:id="@+id/tvAccountEmail"
                            style="@style/Gozar.Row.Title"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textDirection="ltr" />

                        <TextView
                            android:id="@+id/tvAccountPlan"
                            style="@style/Gozar.Row.Subtitle" />
                    </LinearLayout>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/usage_month"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvUsagePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0%"
                        android:textAppearance="@style/TextAppearance.Gozar.TitleLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textDirection="ltr" />
                </LinearLayout>

                <com.gozar.UsageMeterView
                    android:id="@+id/usageMeter"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvUsageUsed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvUsageLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccounts"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/manage_accounts" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccountRefresh"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_refresh" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSignOut"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/fox_sign_out" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/visual" />

        <LinearLayout
            android:id="@+id/rowLang"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_flower"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/language"
                android:src="@drawable/ic_translate"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/language" />
                <TextView
                    android:id="@+id/tvLang"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTheme"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_flower"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/theme"
                android:src="@drawable/ic_palette"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/theme" />
                <TextView
                    android:id="@+id/tvTheme"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/connection_section" />

        <LinearLayout
            android:id="@+id/rowGeo"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_burst"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/geolocation"
                android:src="@drawable/ic_location"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/geolocation" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/geolocation_desc" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swGeo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowRecents"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_hex"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/recents"
                android:src="@drawable/ic_time"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/recents" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/recents_desc" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/about_section" />

        <LinearLayout
            android:id="@+id/rowUpdate"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_clover"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/check_updates"
                android:src="@drawable/ic_refresh"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/check_updates" />
                <TextView
                    android:id="@+id/tvUpdate"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowGithub"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_gem"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/project"
                android:src="@drawable/ic_published"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/project" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/project_desc" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAbout"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_puff"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/about"
                android:src="@drawable/ic_info"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/about" />
                <TextView
                    android:id="@+id/tvAbout"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>


        <TextView
            style="@style/Gozar.Section"
            android:text="@string/advanced_section" />

        <LinearLayout
            android:id="@+id/rowRouting"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_gem"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/routing"
                android:src="@drawable/ic_alt_route"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/routing" />
                <TextView
                    android:id="@+id/tvRouting"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowChain"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_clover"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/chain"
                android:src="@drawable/ic_link"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/chain" />
                <TextView
                    android:id="@+id/tvChain"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowApps"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_hex"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/apps"
                android:src="@drawable/ic_apps"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/apps" />
                <TextView
                    android:id="@+id/tvApps"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/donate_section" />

        <LinearLayout
            android:id="@+id/rowDonate"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_flower"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/donate_section"
                android:src="@drawable/ic_heart"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/donate_section" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/donate_desc" />
            </LinearLayout>
            <ImageView style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
