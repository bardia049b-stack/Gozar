<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_s"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/sp_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_s"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textAppearance="@style/TextAppearance.Gozar.HeadlineSmall"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchBox"
            style="@style/Gozar.Field"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSettingsSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_settings"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/bannerSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:background="@drawable/banner"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/sp_l">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_soft"
                android:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:contentDescription="@string/support"
                android:padding="11dp"
                android:src="@drawable/ic_volunteer"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/support"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/support_desc"
                    android:textColor="?attr/colorOnPrimaryContainer" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/visual" />

        <LinearLayout
            android:id="@+id/rowLang"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_flower"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/language"
                android:src="@drawable/ic_language"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/language" />
                <TextView
                    android:id="@+id/tvLang"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTheme"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_puff"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/theme"
                android:src="@drawable/ic_contrast"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/theme" />
                <TextView
                    android:id="@+id/tvTheme"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/connection_section" />

        <LinearLayout
            android:id="@+id/rowKill"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_hex"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/kill_switch"
                android:src="@drawable/ic_vpn_lock"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/kill_switch" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/kill_switch_short" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swKill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAuto"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_burst"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/auto_connect"
                android:src="@drawable/ic_auto"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/auto_connect" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/auto_connect_desc" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLan"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_squircle"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/lan"
                android:src="@drawable/ic_devices"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/lan" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/lan_desc" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowNotif"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_gem"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/notif_speed"
                android:src="@drawable/ic_bell"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/notif_speed" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/notif_speed_desc" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/proxy_section" />

        <LinearLayout
            android:id="@+id/rowProxy"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_clover"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/proxy_mode"
                android:src="@drawable/ic_router_alt"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/proxy_mode" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/proxy_desc" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swProxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowPort"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_circle"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/proxy_port"
                android:src="@drawable/ic_router"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/proxy_port" />
                <TextView
                    android:id="@+id/tvProxyPort"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/split" />

        <LinearLayout
            android:id="@+id/rowSplitMode"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_hex"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/split_mode"
                android:src="@drawable/ic_rule"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/split_mode" />
                <TextView
                    android:id="@+id/tvSplitMode"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSplitApps"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_squircle"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/split_apps"
                android:src="@drawable/ic_apps"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/split_apps" />
                <TextView
                    android:id="@+id/tvSplitApps"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/updates_section" />

        <LinearLayout
            android:id="@+id/rowUpdate"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_circle"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/check_updates"
                android:src="@drawable/ic_system_update"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/check_updates" />
                <TextView
                    android:id="@+id/tvUpdate"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/Gozar.Section"
            android:text="@string/about_section" />

        <LinearLayout
            android:id="@+id/rowVpnSettings"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_puff"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/vpn_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/vpn_settings" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/vpn_settings_desc" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowGithub"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_burst"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/support"
                android:src="@drawable/ic_open_app"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/support" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/support_desc" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCrash"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_flower"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/crash_title"
                android:src="@drawable/ic_bug"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/crash_title" />
                <TextView
                    style="@style/Gozar.Row.Subtitle"
                    android:text="@string/crash_desc" />
            </LinearLayout>
            <ImageView
                style="@style/Gozar.Row.Chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCore"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_gem"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/core"
                android:src="@drawable/ic_memory"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/core" />
                <TextView
                    android:id="@+id/tvCore"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAbout"
            style="@style/Gozar.Row">

            <ImageView
                style="@style/Gozar.Tile"
                android:background="@drawable/frame_clover"
                android:backgroundTint="@color/tile_container"
                android:contentDescription="@string/about"
                android:src="@drawable/ic_info"
                app:tint="@color/tile_on_container" />

            <LinearLayout style="@style/Gozar.Row.Text">
                <TextView
                    style="@style/Gozar.Row.Title"
                    android:text="@string/about" />
                <TextView
                    android:id="@+id/tvAbout"
                    style="@style/Gozar.Row.Subtitle" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvKillDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_l"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/kill_switch_desc"
            android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvExportNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/export_note"
            android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
