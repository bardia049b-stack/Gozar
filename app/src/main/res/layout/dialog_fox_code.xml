<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_xl"
    android:paddingTop="@dimen/sp_m"
    android:paddingEnd="@dimen/sp_xl">

    <TextView
        android:id="@+id/foxCodeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fox_code_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text2" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_m"
        android:hint="@string/fox_code">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/foxCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="12"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
