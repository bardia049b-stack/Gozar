<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="22dp"
    android:background="@drawable/glass"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQrName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivQr"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="18dp"
        android:background="#FFFFFF"
        android:padding="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <TextView android:id="@+id/btnQrSave" style="@style/SmallBtn" android:layout_width="0dp" android:layout_weight="1" android:text="@string/qr_save" />
        <TextView android:id="@+id/btnQrShare" style="@style/SmallBtn" android:layout_width="0dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/menu_share" />
    </LinearLayout>
</LinearLayout>
