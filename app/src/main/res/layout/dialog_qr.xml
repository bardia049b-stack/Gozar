<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/sp_xxl">

    <TextView
        android:id="@+id/tvQrName"
        style="@style/Gozar.Row.Title"
        android:ellipsize="end"
        android:maxLines="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_l"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/sp_l"
        app:cardElevation="0dp"
        app:contentPadding="@dimen/sp_l">

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="match_parent"
            android:layout_height="248dp"
            android:contentDescription="@string/menu_qr"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_s"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQrSave"
            style="@style/Widget.Gozar.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQrShare"
            style="@style/Widget.Gozar.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_xs"
            android:text="@string/menu_share" />
    </LinearLayout>
</LinearLayout>
