<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/foxRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/screen_gutter" android:paddingTop="@dimen/sp_m" android:paddingEnd="@dimen/screen_gutter">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="@string/fox_title" android:src="@drawable/fox_red_logo" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp_m" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fox_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView android:id="@+id/foxAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/fox_signed_out" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/text2" />
        </LinearLayout>
        <ImageButton android:id="@+id/foxAccountButton" android:layout_width="@dimen/icon_action" android:layout_height="@dimen/icon_action" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/fox_account" android:src="@drawable/ic_account" app:tint="@color/icon" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/screen_gutter" android:paddingTop="@dimen/sp_s" android:paddingEnd="@dimen/screen_gutter" android:paddingBottom="@dimen/sp_xl">
            <FrameLayout android:id="@+id/foxHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fox_hero">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/sp_l" android:paddingTop="@dimen/sp_xl" android:paddingEnd="@dimen/sp_l" android:paddingBottom="@dimen/sp_xl">
                    <com.gozar.ConnectControl android:id="@+id/foxConnect" android:layout_width="168dp" android:layout_height="168dp" android:contentDescription="@string/connect" />
                    <TextView android:id="@+id/foxState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_l" android:gravity="center" android:text="@string/fox_disconnected" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/foxQuotaText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_xs" android:gravity="center" android:text="@string/fox_usage_pending" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                    <ProgressBar android:id="@+id/foxQuotaBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="@dimen/sp_m" android:max="100" android:progress="0" android:progressBackgroundTint="@color/m3_outline_variant" android:progressTint="@color/m3_primary" />
                    <TextView android:id="@+id/foxReset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_s" android:gravity="center" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
                    <TextView android:id="@+id/foxError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_s" android:gravity="center" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurface" android:visibility="gone" />
                    <LinearLayout android:id="@+id/foxLive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_m" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <com.gozar.CountryFlagView android:id="@+id/foxLiveFlag" android:layout_width="@dimen/sp_xxl" android:layout_height="@dimen/sp_xxl" android:contentDescription="@string/fox_location" />
                        <TextView android:id="@+id/foxLiveIp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:includeFontPadding="false" android:maxLines="1" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" android:textDirection="ltr" />
                        <TextView android:id="@+id/foxLivePing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/sp_m" android:includeFontPadding="false" android:maxLines="1" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorOnSurfaceVariant" android:textDirection="ltr" />
                    </LinearLayout>
                </LinearLayout>
                <ImageButton android:id="@+id/foxMap" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:layout_gravity="top|end" android:layout_marginTop="@dimen/sp_m" android:layout_marginEnd="@dimen/sp_m" android:background="@drawable/bg_map_button" android:contentDescription="@string/open_live_map" android:padding="14dp" android:src="@drawable/ic_map" android:visibility="gone" app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>
            <LinearLayout android:id="@+id/foxStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_l" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.gozar.MetricIconView android:layout_width="@dimen/metric_icon" android:layout_height="@dimen/metric_icon" android:contentDescription="@string/download" android:padding="@dimen/metric_icon_pad" android:src="@drawable/ic_down" android:id="@+id/foxDownIcon" />
                    <com.gozar.RollingValueView android:id="@+id/foxDown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_xs" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="0 B/s" android:textAppearance="@style/TextAppearance.Gozar.TitleMedium" android:textColor="@color/metric_number" android:textDirection="ltr" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="@string/download" android:textAppearance="@style/TextAppearance.Gozar.LabelSmall" android:textColor="@color/metric_label" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.gozar.MetricIconView android:layout_width="@dimen/metric_icon" android:layout_height="@dimen/metric_icon" android:contentDescription="@string/upload" android:padding="@dimen/metric_icon_pad" android:src="@drawable/ic_up" android:id="@+id/foxUpIcon" />
                    <com.gozar.RollingValueView android:id="@+id/foxUp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_xs" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="0 B/s" android:textAppearance="@style/TextAppearance.Gozar.TitleMedium" android:textColor="@color/metric_number" android:textDirection="ltr" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="@string/upload" android:textAppearance="@style/TextAppearance.Gozar.LabelSmall" android:textColor="@color/metric_label" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.gozar.MetricIconView android:layout_width="@dimen/metric_icon" android:layout_height="@dimen/metric_icon" android:contentDescription="@string/total" android:padding="@dimen/metric_icon_pad" android:src="@drawable/ic_data" android:id="@+id/foxTotalIcon" />
                    <com.gozar.RollingValueView android:id="@+id/foxTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_xs" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="0 B" android:textAppearance="@style/TextAppearance.Gozar.TitleMedium" android:textColor="@color/metric_number" android:textDirection="ltr" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="@string/total" android:textAppearance="@style/TextAppearance.Gozar.LabelSmall" android:textColor="@color/metric_label" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <com.gozar.MetricIconView android:layout_width="@dimen/metric_icon" android:layout_height="@dimen/metric_icon" android:contentDescription="@string/fox_session" android:padding="@dimen/metric_icon_pad" android:src="@drawable/ic_timer" android:id="@+id/foxSessionIcon" />
                    <TextView android:id="@+id/foxSession" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_xs" android:ellipsize="end" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="00:00" android:textAppearance="@style/TextAppearance.Gozar.TitleMedium" android:textColor="@color/metric_number" android:textDirection="ltr" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="@string/fox_session" android:textAppearance="@style/TextAppearance.Gozar.LabelSmall" android:textColor="@color/metric_label" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/foxChartCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardCornerRadius="@dimen/radius_m" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/sp_l">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chart_title" android:textAppearance="@style/TextAppearance.Gozar.TitleMedium" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/chart_detail" android:textAppearance="@style/TextAppearance.Gozar.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.gozar.TrafficChartView android:id="@+id/foxChart" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="@dimen/sp_m" android:contentDescription="@string/chart_title" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_m" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/sp_l" android:text="@string/chart_download" android:textAppearance="@style/TextAppearance.Gozar.LabelMedium" android:textColor="@color/kind_down" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/sp_l" android:text="@string/chart_upload" android:textAppearance="@style/TextAppearance.Gozar.LabelMedium" android:textColor="@color/kind_up" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/foxServerRow" style="@style/Gozar.Row">
                <com.gozar.CountryFlagView android:id="@+id/foxServerFlag" android:layout_width="@dimen/tile_size" android:layout_height="@dimen/tile_size" android:contentDescription="@string/fox_server_title" />
                <LinearLayout style="@style/Gozar.Row.Text">
                    <TextView android:id="@+id/foxServerName" style="@style/Gozar.Row.Title" android:ellipsize="end" android:maxLines="1" android:text="@string/fox_server_empty" />
                    <TextView android:id="@+id/foxServerMeta" style="@style/Gozar.Row.Subtitle" android:maxLines="1" android:text="@string/fox_servers_sub" />
                </LinearLayout>
                <ImageView style="@style/Gozar.Row.Chevron" android:contentDescription="@string/fox_servers_pick" />
            </LinearLayout>
            <TextView android:id="@+id/foxServerDelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sp_xs" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/text2" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
