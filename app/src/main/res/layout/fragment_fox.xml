<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/foxRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_m"
        android:paddingEnd="@dimen/screen_gutter">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/fox_title"
            android:src="@drawable/fox_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fox_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/foxAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/fox_signed_out"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text2" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/foxAccountButton"
            android:layout_width="@dimen/icon_action"
            android:layout_height="@dimen/icon_action"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fox_account"
            android:src="@drawable/ic_account"
            app:tint="@color/icon" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/sp_m"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/sp_xl">

            <LinearLayout
                android:id="@+id/foxHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fox_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/sp_l">

                <ImageView
                    android:id="@+id/foxHeroLogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/fox_title"
                    android:src="@drawable/fox_logo" />

                <TextView
                    android:id="@+id/foxState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:text="@string/fox_plan_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/fox_on_red" />

                <TextView
                    android:id="@+id/foxQuotaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_xs"
                    android:gravity="center"
                    android:text="@string/fox_quota_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/fox_dim" />

                <ProgressBar
                    android:id="@+id/foxQuotaBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="@dimen/sp_s"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#4DFFFFFF"
                    android:progressTint="@color/fox_cream" />

                <TextView
                    android:id="@+id/foxReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/fox_dim"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/foxPrimary"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_m"
                    android:text="@string/fox_sign_in"
                    android:textColor="@color/fox_red_dark"
                    app:backgroundTint="@color/fox_cream" />

                <TextView
                    android:id="@+id/foxError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/fox_dim"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/foxStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_m"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fox_location"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text2" />

                        <TextView
                            android:id="@+id/foxStatLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fox_exit"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text2" />

                        <TextView
                            android:id="@+id/foxStatExit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fox_speed"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text2" />

                        <TextView
                            android:id="@+id/foxStatSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fox_session"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text2" />

                        <TextView
                            android:id="@+id/foxStatSession"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_s"
                    android:text="@string/fox_proxy_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/text2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fox_servers"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/foxLogs"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fox_logs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/foxMeasure"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fox_measure" />
            </LinearLayout>

            <TextView
                android:id="@+id/foxHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_xs"
                android:text="@string/fox_servers_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text2" />

            <LinearLayout
                android:id="@+id/foxServers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_s"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
