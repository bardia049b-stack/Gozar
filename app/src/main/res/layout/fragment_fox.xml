<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/foxRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/sp_m"
        android:paddingEnd="@dimen/screen_gutter">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/fox_title"
            android:src="@drawable/fox_red_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fox_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/foxAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/fox_signed_out"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text2" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/foxAccountButton"
            android:layout_width="@dimen/icon_action"
            android:layout_height="@dimen/icon_action"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fox_account"
            android:src="@drawable/ic_account"
            app:tint="@color/icon" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/sp_s"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/sp_xl">

            <FrameLayout
                android:id="@+id/foxHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fox_hero">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sp_l"
                    android:paddingTop="18dp"
                    android:paddingEnd="@dimen/sp_l"
                    android:paddingBottom="18dp">

                    <com.gozar.ConnectControl
                        android:id="@+id/foxConnect"
                        android:layout_width="168dp"
                        android:layout_height="168dp"
                        android:contentDescription="@string/connect" />

                    <TextView
                        android:id="@+id/foxState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sp_m"
                        android:gravity="center"
                        android:text="@string/fox_plan_title"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/fox_on_red" />

                    <TextView
                        android:id="@+id/foxQuotaText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/fox_quota_empty"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/fox_dim" />

                    <ProgressBar
                        android:id="@+id/foxQuotaBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="@dimen/sp_s"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="#4DFFFFFF"
                        android:progressTint="@color/fox_cream" />

                    <TextView
                        android:id="@+id/foxReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/fox_dim"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/foxError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/fox_cream"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/foxLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.gozar.CountryFlagView
                            android:id="@+id/foxLiveFlag"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/fox_location" />

                        <TextView
                            android:id="@+id/foxLiveIp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/fox_cream"
                            android:textDirection="ltr" />

                        <TextView
                            android:id="@+id/foxLivePing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/fox_dim"
                            android:textDirection="ltr" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/foxMap"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_map_button"
                    android:contentDescription="@string/open_live_map"
                    android:padding="11dp"
                    android:src="@drawable/ic_map"
                    android:visibility="gone"
                    app:tint="@color/fox_cream" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/foxStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_l"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/frame_puff"
                        android:backgroundTint="@color/tile_container"
                        android:contentDescription="@string/download"
                        android:padding="16dp"
                        android:src="@drawable/ic_down"
                        app:tint="@color/tile_on_container" />

                    <com.gozar.RollingValueView
                        android:id="@+id/foxDown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0 B/s"
                        android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                        android:textColor="@color/metric_number"
                        android:textDirection="ltr" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/download"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                        android:textColor="@color/metric_label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/frame_gem"
                        android:backgroundTint="@color/m3_primary"
                        android:contentDescription="@string/upload"
                        android:padding="16dp"
                        android:src="@drawable/ic_up"
                        app:tint="@color/m3_on_primary" />

                    <com.gozar.RollingValueView
                        android:id="@+id/foxUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0 B/s"
                        android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                        android:textColor="@color/metric_number"
                        android:textDirection="ltr" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/upload"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                        android:textColor="@color/metric_label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/frame_hex"
                        android:backgroundTint="@color/m3_tertiary_container"
                        android:contentDescription="@string/total"
                        android:padding="16dp"
                        android:src="@drawable/ic_data"
                        app:tint="@color/m3_on_tertiary_container" />

                    <com.gozar.RollingValueView
                        android:id="@+id/foxTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0 B"
                        android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                        android:textColor="@color/metric_number"
                        android:textDirection="ltr" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/total"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                        android:textColor="@color/metric_label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/frame_flower"
                        android:backgroundTint="@color/m3_secondary_container"
                        android:contentDescription="@string/fox_session"
                        android:padding="16dp"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/m3_on_secondary_container" />

                    <TextView
                        android:id="@+id/foxSession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="00:00"
                        android:textAppearance="@style/TextAppearance.Gozar.TitleMedium"
                        android:textColor="@color/metric_number"
                        android:textDirection="ltr" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/fox_session"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                        android:textColor="@color/metric_label" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/foxServerRow"
                style="@style/Gozar.Row">

                <com.gozar.CountryFlagView
                    android:id="@+id/foxServerFlag"
                    android:layout_width="@dimen/tile_size"
                    android:layout_height="@dimen/tile_size"
                    android:contentDescription="@string/fox_server_title" />

                <LinearLayout style="@style/Gozar.Row.Text">

                    <TextView
                        android:id="@+id/foxServerName"
                        style="@style/Gozar.Row.Title"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/fox_server_empty" />

                    <TextView
                        android:id="@+id/foxServerMeta"
                        style="@style/Gozar.Row.Subtitle"
                        android:maxLines="1"
                        android:text="@string/fox_servers_sub" />
                </LinearLayout>

                <ImageView
                    style="@style/Gozar.Row.Chevron"
                    android:contentDescription="@string/fox_servers_pick" />
            </LinearLayout>

            <TextView
                android:id="@+id/foxServerDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text2"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
