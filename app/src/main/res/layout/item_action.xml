<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/sp_s"
    android:paddingBottom="@dimen/sp_s">

    <ImageView
        android:id="@+id/actionIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/frame_burst"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:contentDescription="@string/add"
        android:padding="16dp"
        app:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/actionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_s"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Gozar.LabelMedium"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
