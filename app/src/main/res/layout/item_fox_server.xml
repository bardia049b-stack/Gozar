<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/sp_s"
    android:paddingTop="@dimen/sp_s"
    android:paddingEnd="@dimen/sp_s"
    android:paddingBottom="@dimen/sp_s">

    <com.gozarwg.CountryFlagView
        android:id="@+id/foxFlag"
        android:layout_width="30dp"
        android:layout_height="30dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/foxCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/foxCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text2" />
    </LinearLayout>

    <TextView
        android:id="@+id/foxDelay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/sp_s"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@color/text2" />

    <ImageView
        android:id="@+id/foxCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/fox_selected"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/fox_red" />
</LinearLayout>
