<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical"
    android:paddingBottom="@dimen/sp_l">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sp_m"
        android:background="@drawable/pill"
        android:backgroundTint="?attr/colorOutlineVariant" />

    <TextView
        android:id="@+id/tvSheetTitle"
        style="@style/Gozar.Sheet.Title"
        android:layout_marginTop="@dimen/sp_s"
        android:text="@string/add_title" />

    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_l"
        android:layout_marginEnd="@dimen/sp_l"
        android:background="@drawable/menu_group"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:paddingTop="@dimen/sp_xs"
        android:paddingBottom="@dimen/sp_xs" />

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sp_m"
        android:background="@android:color/transparent" />
</LinearLayout>
