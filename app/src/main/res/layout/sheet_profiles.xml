<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical"
    android:paddingBottom="@dimen/sp_l">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sp_m"
        android:background="@drawable/pill"
        android:backgroundTint="?attr/colorOutlineVariant" />

    <TextView
        style="@style/Gozar.Sheet.Title"
        android:layout_marginTop="@dimen/sp_s"
        android:text="@string/profiles" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/sp_s"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvNoProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/sp_xxl"
            android:textAppearance="@style/TextAppearance.Gozar.BodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btnSheetAdd"
        style="@style/Gozar.Row"
        android:layout_marginStart="@dimen/sp_l"
        android:layout_marginTop="@dimen/sp_s"
        android:layout_marginEnd="@dimen/sp_l"
        android:background="@drawable/pill_outline"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:minHeight="64dp">

        <ImageView
            style="@style/Gozar.Tile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/frame_clover"
            android:backgroundTint="@color/tile_container"
            android:contentDescription="@string/add_profile"
            android:padding="7dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/tile_on_container" />

        <TextView
            style="@style/Gozar.Row.Title"
            android:layout_marginStart="@dimen/sp_m"
            android:text="@string/add_profile"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</LinearLayout>
