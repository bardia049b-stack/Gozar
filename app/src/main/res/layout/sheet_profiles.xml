<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerLow"
    android:orientation="vertical"
    android:paddingBottom="@dimen/sp_l">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sp_m"
        android:background="@drawable/pill"
        android:backgroundTint="?attr/colorOutlineVariant" />

    <TextView
        style="@style/Gozar.Sheet.Title"
        android:layout_marginTop="@dimen/sp_s"
        android:text="@string/profiles" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/sp_s"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvNoProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/sp_xxl"
            android:textAppearance="@style/TextAppearance.Gozar.BodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetAdd"
        style="@style/Widget.Gozar.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_l"
        android:layout_marginTop="@dimen/sp_s"
        android:layout_marginEnd="@dimen/sp_l"
        android:text="@string/add_profile"
        app:icon="@drawable/ic_plus" />
</LinearLayout>
