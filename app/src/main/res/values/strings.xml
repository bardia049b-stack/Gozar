    <string name="console_title">Console</string>
    <string name="console_desc">Xbox and PlayStation profiles with the exact menu paths</string>
    <string name="console_dialog_title">Console profile</string>
    <string name="console_playstation">PlayStation 5</string>
    <string name="console_xbox">Xbox Series X|S</string>
    <string name="console_none">No console</string>
    <string name="console_ps_steps">Settings → Network → Settings → Set Up Internet Connection, then pick Wi-Fi or LAN and open Advanced Settings. Proxy Server must be set to Use with the gateway address and port, and DNS Settings to Manual with the same address. Test Internet Connection at the end.</string>
    <string name="console_xbox_steps">Settings → General → Network settings → Advanced settings. Xbox has no proxy field: set DNS settings to Manual with the gateway address and let the computer share its connection. Test network connection at the end.</string>
    <string name="console_note">A console sends only TCP through a proxy; game datagrams travel through the computer gateway. Turn on Console mode on the desktop app and point the console at its address.</string>
    <string name="console_selected">Console profile: %1$s</string>
    <string name="console_lan_note">LAN bypass is enabled so local streaming and the console gateway keep working.</string>
    <string name="udp_section">UDP Mode</string>
    <string name="console_master_title">Console / Game Mode</string>
    <string name="console_master_desc">Off: Mozilla relay only (TCP). Low data and battery use.</string>
    <string name="console_master_on">On: UDP routing is active. Pick a mode below.</string>
    <string name="udp_mode_title">UDP Mode</string>
    <string name="udp_normal_title">Normal</string>
    <string name="udp_normal_desc">Web and video calls go through Mozilla, game traffic goes through WARP. (Lowest WARP data use.)</string>
    <string name="udp_game_title">Game Mode</string>
    <string name="udp_game_desc">All UDP traffic (web, calls, games) goes through WARP. (Best NAT type and ping for Xbox/PS5, but higher WARP data use.)</string>
    <string name="udp_relay_title">Mozilla only (emergency)</string>
    <string name="udp_relay_desc">UDP traffic only goes through Mozilla\'s allowed ports. (Use when WARP is blocked on your network. Online games may not work.)</string>
    <string name="udp_battery_title">Battery saver</string>
    <string name="udp_battery_desc">Keeps WARP only for game ports, even if Game Mode is selected.</string>
    <string name="udp_battery_warning">Game Mode keeps two tunnels alive and uses more battery and WARP data.</string>
    <string name="udp_relay_warning">To make online games work, you also need to turn on "UDP Relay".</string>
    <string name="udp_relay_warning_action">Turn on UDP Relay</string>
    <string name="udp_warp_via_title">WARP carrier</string>
    <string name="udp_warp_direct">Direct (fastest)</string>
    <string name="udp_warp_relay">Through Mozilla (when UDP 443 is blocked)</string>
    <string name="udp_restart_note">Changes apply to new connections. Reconnect to apply them to the current session.</string>
    <string name="help_title">Guide</string>
    <string name="help_desc">Simple steps for browsing and for PS5/Xbox</string>
    <string name="help_browse_title">Normal browsing</string>
    <string name="help_browse_body">Just press Connect. Web traffic and DNS go through the Mozilla relay. You do not need WARP or Game Mode for this.</string>
    <string name="help_console_title">Playing on PS5 or Xbox</string>
    <string name="help_console_body">Open Settings, go to Connection, turn on Console / Game Mode, then choose Game Mode. Connect your console to the gateway address shown in the Console section.</string>
    <string name="help_blocked_title">If WARP is blocked</string>
    <string name="help_blocked_body">Choose Mozilla only (emergency). UDP then uses just the allowed Mozilla ports. Online games may not work, but browsing and calls keep working.</string>
    <string name="help_battery_title">Battery and data</string>
    <string name="help_battery_body">Game Mode uses more battery because two tunnels stay open. Turn on Battery saver to keep WARP only for game ports, or turn off Console / Game Mode when you finish playing.</string>
    <string name="help_network_title">Switching Wi-Fi and mobile data</string>
    <string name="help_network_body">Gozar rebuilds the tunnels automatically when the network changes. A short pause during a switch is normal.</string>
    <string name="udp_relay_toggle_title">UDP Relay</string>
    <string name="udp_relay_toggle_desc">Carries datagrams over the Mozilla tunnel. Online games need this on.</string>
</resources>
