<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Gozar.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/row_pad_start</item>
        <item name="android:layout_marginEnd">@dimen/row_pad_end</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="Gozar.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/sp_xs</item>
        <item name="android:layout_marginTop">@dimen/sp_xxl</item>
        <item name="android:layout_marginBottom">@dimen/sp_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.Gozar.TitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Gozar.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/row_gap</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/row_pad_start</item>
        <item name="android:paddingEnd">@dimen/row_pad_end</item>
        <item name="android:paddingTop">@dimen/sp_m</item>
        <item name="android:paddingBottom">@dimen/sp_m</item>
        <item name="android:background">@drawable/row_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Gozar.Row.Static" parent="@style/Gozar.Row">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:foreground">@null</item>
    </style>

    <style name="Gozar.Row.Text" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/sp_l</item>
        <item name="android:layout_marginEnd">@dimen/sp_m</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Gozar.Row.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Gozar.TitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Gozar.Row.Subtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Gozar.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Gozar.Row.Chevron" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chev</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Gozar.Tile" parent="">
        <item name="android:layout_width">@dimen/tile_size</item>
        <item name="android:layout_height">@dimen/tile_size</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/tile</item>
        <item name="android:backgroundTint">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Gozar.Tile.Icon" parent="@style/Gozar.Tile">
        <item name="android:tint">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="Gozar.Sheet.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/sp_xxl</item>
        <item name="android:paddingEnd">@dimen/sp_xxl</item>
        <item name="android:paddingTop">@dimen/sp_m</item>
        <item name="android:paddingBottom">@dimen/sp_m</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Gozar.Sheet.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/sp_xxl</item>
        <item name="android:paddingEnd">@dimen/sp_xxl</item>
        <item name="android:paddingTop">@dimen/sp_m</item>
        <item name="android:paddingBottom">@dimen/sp_s</item>
        <item name="android:textAppearance">@style/TextAppearance.Gozar.TitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Gozar.Toolbar.Title" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Gozar.TitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="Gozar.Stat.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Gozar.TitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Gozar.Stat.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Gozar.LabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Gozar.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextAppearance">@style/TextAppearance.Gozar.BodyMedium</item>
    </style>

</resources>
