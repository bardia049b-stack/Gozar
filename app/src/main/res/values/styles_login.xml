<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Gozar.Login.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/login_field</item>
        <item name="boxStrokeColor">@color/login_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/login_accent</item>
        <item name="android:textColorHint">@color/login_text_dim</item>
        <item name="startIconTint">@color/login_text_dim</item>
        <item name="endIconTint">@color/login_text_dim</item>
    </style>

    <style name="Gozar.Login.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/login_text</item>
        <item name="android:textColorHighlight">#44FF3B54</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Gozar.Login.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/login_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/login_ripple</item>
    </style>

    <style name="Gozar.Login.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/login_primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Gozar.Login.Social" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/login_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">#00000000</item>
        <item name="strokeColor">@color/login_card_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/login_ripple</item>
    </style>

    <style name="Gozar.Login.Switch" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/login_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/login_ripple</item>
    </style>

    <style name="Gozar.Login.Well" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_login_well</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Gozar.Login.Well.Icon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:alpha">0.72</item>
        <item name="android:tint">@color/login_text_dim</item>
    </style>

    <style name="Gozar.Login.Well.Input" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/login_text</item>
        <item name="android:textColorHint">@color/login_text_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColorHighlight">#44FF3B54</item>
    </style>
</resources>
