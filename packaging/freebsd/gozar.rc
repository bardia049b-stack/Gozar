#!/bin/sh

# PROVIDE: gozar
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="gozar"
rcvar="gozar_enable"

load_rc_config $name

: ${gozar_enable:="NO"}
: ${gozar_args:="--headless"}
: ${gozar_config:="/var/db/gozar"}

command="/usr/local/bin/gozar-core"
command_args="${gozar_args}"
pidfile="/var/run/${name}.pid"

gozar_prestart() {
	kldstat -q -m if_tun 2>/dev/null || kldload if_tun 2>/dev/null
	/bin/mkdir -p "${gozar_config}"
	export XDG_CONFIG_HOME="${gozar_config}"
	return 0
}

gozar_poststop() {
	XDG_CONFIG_HOME="${gozar_config}" /usr/local/bin/gozar-core --clear-proxy >/dev/null 2>&1
	return 0
}

start_precmd="gozar_prestart"
stop_postcmd="gozar_poststop"

run_rc_command "$1"
