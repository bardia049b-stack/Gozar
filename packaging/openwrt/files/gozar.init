#!/bin/sh /etc/rc.common

START=92
STOP=12
USE_PROCD=1

PROG=/usr/bin/gozar-core
STATE=/etc/gozar

sign_in() {
	local email="$1"
	local password="$2"
	local code="$3"
	[ -n "$email" ] || return 0
	[ -n "$password" ] || return 0
	if [ -n "$code" ]; then
		XDG_CONFIG_HOME="$STATE" "$PROG" --email "$email" --password "$password" --code "$code" >/dev/null 2>&1
	else
		XDG_CONFIG_HOME="$STATE" "$PROG" --email "$email" --password "$password" >/dev/null 2>&1
	fi
}

start_service() {
	config_load gozar
	local enabled email password code server command
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get email main email ""
	config_get password main password ""
	config_get code main code ""
	config_get server main server ""
	config_get command main command "--headless"

	mkdir -p "$STATE"

	if [ ! -s "$STATE/Gozar/config.json" ]; then
		sign_in "$email" "$password" "$code"
	fi

	procd_open_instance main
	procd_set_param command "$PROG" $command
	procd_set_param env XDG_CONFIG_HOME="$STATE"
	procd_set_param env GOZAR_SERVER="$server"
	procd_set_param respawn 3600 5 0
	procd_set_param limits core="0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gozar
}

stop_service() {
	XDG_CONFIG_HOME="$STATE" "$PROG" --clear-proxy >/dev/null 2>&1
	return 0
}
